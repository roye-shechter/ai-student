// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// =====================================================
// NextAuth.js Models
// =====================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================================================
// Core Application Models
// =====================================================

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  username         String    @unique
  passwordHash     String?
  fullName         String?
  avatarUrl        String?
  role             String    @default("student")
  institution         String?
  studyYear           String?
  onboardingCompleted Boolean   @default(false)
  moodleUserId     String?   @unique
  moodleAccessToken String?
  moodleRefreshToken String?
  tokenExpiresAt   DateTime?
  emailVerified    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  // Relations
  accounts      Account[]
  sessions      Session[]
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
  learningSessions LearningSession[]
  documents     Document[]
  chatSessions  ChatSession[]
  createdCourses Course[]      @relation("CreatedCourses")
  usageCounters UsageCounter[]

  @@index([email])
  @@index([username])
  @@index([moodleUserId])
  @@map("users")
}

model Course {
  id             String    @id @default(cuid())
  moodleCourseId String?   @unique
  courseCode     String    @unique
  courseName     String
  description    String?
  credits        Float     @default(0)
  instructorName String?
  creatorId      String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  creator          User?             @relation("CreatedCourses", fields: [creatorId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  learningSessions LearningSession[]
  documents        Document[]
  chatSessions     ChatSession[]

  @@index([courseCode])
  @@index([moodleCourseId])
  @@index([creatorId])
  @@map("courses")
}

model Enrollment {
  id                    String    @id @default(cuid())
  userId                String
  courseId              String
  enrolledAt            DateTime  @default(now())
  completionPercentage  Float     @default(0.00)
  lastAccessedAt        DateTime?
  isActive              Boolean   @default(true)

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model QuizAttempt {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  quizTitle        String
  moodleQuizId     String?
  scorePercentage  Float?
  totalQuestions   Int?
  correctAnswers   Int?
  timeSpentSeconds Int?
  attemptedAt      DateTime  @default(now())

  // Relations
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([userId])
  @@index([courseId])
  @@map("quiz_attempts")
}

// Question-level detail for a QuizAttempt: the generated question, the
// student's answer, and Claude's grading/feedback. `correctAnswer` is
// withheld from the client until the attempt is submitted for grading.
model QuizQuestion {
  id            String   @id @default(cuid())
  quizAttemptId String
  order         Int
  type          String // "mcq" | "short"
  questionText  String
  choices       Json? // string[] for "mcq"
  correctAnswer String?
  topic         String? // short tag powering weak-topic tracking in the chat feedback loop
  sourceChunks  Json? // [{documentId, fileName, chunkIndex}] citations from retrieval
  studentAnswer String?
  isCorrect     Boolean?
  score         Float? // 0..1, partial credit for short answers
  feedback      String? // Claude's specific "what to improve" text
  createdAt     DateTime @default(now())

  quizAttempt QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)

  @@index([quizAttemptId])
  @@index([quizAttemptId, isCorrect])
  @@map("quiz_questions")
}

model LearningSession {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  sessionStart    DateTime
  sessionEnd      DateTime?
  durationMinutes Int?
  activityType    String?
  createdAt       DateTime  @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([sessionStart])
  @@map("learning_sessions")
}

// Coarse daily quota tracking for cost control. One row per (userId, day);
// incremented atomically on every chat/upload request. See lib/rate-limit.ts.
model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  day         DateTime // truncated to midnight UTC
  chatCount   Int      @default(0)
  uploadCount Int      @default(0)
  quizCount   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("usage_counters")
}

// =====================================================
// RAG Models (embeddings live in Postgres via pgvector — see DocumentChunk)
// =====================================================

// Tracks an uploaded file. The chunk embeddings themselves live in
// DocumentChunk; this row records ingestion status and bookkeeping.
model Document {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  title         String
  fileType      String?
  fileSizeBytes BigInt?
  status        String   @default("pending") // pending | processing | indexed | failed
  chunkCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
  @@map("documents")
}

// One embedded chunk of a Document's text. `embedding` is a pgvector column
// (Unsupported — Prisma Client can't read/write it directly; every insert
// and similarity search goes through $executeRaw/$queryRaw, see
// lib/rag/ingest.ts and lib/rag/chat.ts). Tenant isolation is a plain SQL
// `WHERE userId = ? AND courseId = ?`, denormalized onto every row instead
// of relying on a join, so retrieval stays a single indexed query.
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  courseId   String
  chunkIndex Int
  text       String
  fileName   String
  uploadedAt DateTime
  embedding  Unsupported("vector(1536)")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId, courseId])
  @@map("document_chunks")
}

// A course-specific conversation thread for a user.
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
  @@map("chat_sessions")
}

// Exact message history for conversational memory.
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant" | "system"
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}
